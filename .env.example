# Public frontend configuration. The app works locally without these.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
VITE_VAPID_PUBLIC_KEY=YOUR_PUBLIC_VAPID_KEY

# NEVER put service-role keys, VAPID private keys, or cron secrets in VITE_ variables.
# Server-only secret names and setup instructions: supabase/README.md.
